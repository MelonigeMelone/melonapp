{
  "name": "extension",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && vite build && vite build -c vite.scripts.config.ts --mode background && vite build -c vite.scripts.config.ts --mode content && node scripts/package.mjs",
    "test": "vitest run"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
