{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MelonApp",
  "version": "0.3.0",
  "identifier": "de.melonigemelone.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "MelonApp",
        "width": 1100,
        "height": 760,
        "minWidth": 360,
        "minHeight": 540
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src ipc: http://ipc.localhost https://api.pwnedpasswords.com; object-src 'none'; frame-src 'none'; base-uri 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "iOS": {
      "minimumSystemVersion": "17.0"
    }
  }
}
