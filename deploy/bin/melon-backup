#!/usr/bin/env bash
set -Eeuo pipefail
cd "$(dirname "$(readlink -f "$0")")/.."

keep_days="${MELON_BACKUP_KEEP_DAYS:-14}"
keep_count="${MELON_BACKUP_KEEP_COUNT:-60}"
umask 077
mkdir -p backups
chmod 700 backups
stamp="$(date -u +%Y%m%dT%H%M%SZ)"
target="backups/melon-$stamp.dump"
sealed="offsite/melon-$stamp.dump.age"
trap 'rm -f "$target.tmp" "$sealed.tmp"' EXIT

local_only=false
if [[ "${1:-}" == "--local" || ! -f backup.env ]]; then
  local_only=true
else
  source ./backup.env
fi
ping_url=""
if [[ "$local_only" == false ]]; then
  ping_url="${BACKUP_PING_URL:-}"
fi

ping() {
  if [[ -n "$ping_url" ]]; then
    curl -fsS -m 10 --retry 3 -o /dev/null --data-raw "$2" "$ping_url$1" || echo "could not reach $ping_url" >&2
  fi
}
die() {
  echo "$1" >&2
  ping /fail "$(hostname): $1"
  exit 1
}
trap 'ping /fail "$(hostname): melon-backup failed in line $LINENO (${BASH_COMMAND%% *})"' ERR

prune() {
  find "$1" -maxdepth 1 -name "$2" -mtime "+$keep_days" -delete
  find "$1" -maxdepth 1 -name "$2" -printf '%T@ %p\n' | sort -rn | tail -n "+$((keep_count + 1))" | cut -d' ' -f2- | xargs -r rm -f
}

docker compose exec -T db pg_dump -U melon -d melon --format=custom > "$target.tmp"
docker compose exec -T db pg_restore --list < "$target.tmp" > /dev/null
mv "$target.tmp" "$target"
chmod 600 "$target"
prune backups 'melon-*.dump'
find backups -maxdepth 1 -name 'restore-*.dump' -mmin +60 -delete
echo "backup: $target ($(du -h "$target" | cut -f1))"

if [[ "$local_only" == true ]]; then
  exit 0
fi
if [[ -z "${BACKUP_TARGET:-}" ]]; then
  ping "" "$(hostname): $target, no offsite copy configured"
  exit 0
fi

recipients="${BACKUP_RECIPIENTS:-backup.recipients}"
command -v age > /dev/null || die "age is not installed, nothing copied (apt install age)"
grep -qE '^(age1|ssh-)' "$recipients" 2> /dev/null || die "no age recipient in $recipients, nothing copied (backups are only copied encrypted)"
mkdir -p offsite
chmod 700 offsite
age -R "$recipients" -o "$sealed.tmp" "$target"
mv "$sealed.tmp" "$sealed"
prune offsite 'melon-*.dump.age'
rsync -a --exclude '*.tmp' -e "ssh -p ${BACKUP_PORT:-23} -i '$BACKUP_SSH_KEY' -o BatchMode=yes" offsite/ "$BACKUP_TARGET"
echo "copied $sealed to $BACKUP_TARGET"
ping "" "$(hostname): $sealed copied"
