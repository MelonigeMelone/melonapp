#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$(readlink -f "$0")")/.."

keep_days="${MELON_BACKUP_KEEP_DAYS:-14}"
keep_count="${MELON_BACKUP_KEEP_COUNT:-60}"
mkdir -p backups
chmod 700 backups
stamp="$(date -u +%Y%m%dT%H%M%SZ)"
target="backups/melon-$stamp.dump"
trap 'rm -f "$target.tmp"' EXIT

docker compose exec -T db pg_dump -U melon -d melon --format=custom > "$target.tmp"
docker compose exec -T db pg_restore --list < "$target.tmp" > /dev/null
mv "$target.tmp" "$target"
chmod 600 "$target"
find backups -name 'melon-*.dump' -mtime "+$keep_days" -delete
find backups -name 'melon-*.dump' -printf '%T@ %p\n' | sort -rn | tail -n "+$((keep_count + 1))" | cut -d' ' -f2- | xargs -r rm -f
echo "backup: $target ($(du -h "$target" | cut -f1))"

if [[ "${1:-}" != "--local" && -f backup.env ]]; then
  source ./backup.env
  rsync -a -e "ssh -p ${BACKUP_PORT:-23} -i '$BACKUP_SSH_KEY' -o BatchMode=yes" backups/ "$BACKUP_TARGET"
  echo "copied to $BACKUP_TARGET"
fi
